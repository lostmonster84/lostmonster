#!/bin/bash

# commit-msg hook - enforces the forensic-block protocol
# If a commit message contains a "--- Forensic Block ---" fence, the
# Verified: and Deferred: fields cannot be blank or contain TODO placeholders.
#
# Bypass with --no-verify if you genuinely need to (e.g. emergency hotfix
# from a phone). Don't make it a habit.
#
# Skips: merge / revert / fixup / squash / amend WIP commits whose first
# line starts with one of those keywords (git auto-generates them).

set -e

MSG_FILE="$1"
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

FIRST_LINE=$(head -1 "$MSG_FILE")
case "$FIRST_LINE" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*)
        exit 0
        ;;
esac

if ! grep -q -- "--- Forensic Block ---" "$MSG_FILE"; then
    exit 0
fi

if ! grep -q -- "--- /Forensic Block ---" "$MSG_FILE"; then
    echo -e "${RED}commit-msg: forensic block opened but never closed${NC}"
    echo -e "${YELLOW}Add a closing '--- /Forensic Block ---' line, or remove the opener.${NC}"
    exit 1
fi

BLOCK=$(awk '/--- Forensic Block ---/{flag=1; next} /--- \/Forensic Block ---/{flag=0} flag' "$MSG_FILE")

VIOLATIONS=()

if echo "$BLOCK" | grep -q "<TODO:"; then
    VIOLATIONS+=("contains <TODO:...> placeholder - someone copy-pasted the generator output without filling it in")
fi

VERIFIED_VAL=$(echo "$BLOCK" | grep -E "^Verified:" | sed 's/^Verified:[[:space:]]*//' || true)
if [ -z "$VERIFIED_VAL" ]; then
    VIOLATIONS+=("Verified: field is empty - state what was tested LIVE on real input ('NONE' is a valid honest answer)")
fi

DEFERRED_VAL=$(echo "$BLOCK" | grep -E "^Deferred:" | sed 's/^Deferred:[[:space:]]*//' || true)
if [ -z "$DEFERRED_VAL" ]; then
    VIOLATIONS+=("Deferred: field is empty - state what was NOT verified end-to-end ('NONE' is a valid honest answer)")
fi

for field in Subsystems Files "Risk surface"; do
    if ! echo "$BLOCK" | grep -qE "^${field}:"; then
        VIOLATIONS+=("missing required field: ${field}:")
    fi
done

if [ ${#VIOLATIONS[@]} -gt 0 ]; then
    echo -e "${RED}========================================${NC}"
    echo -e "${RED}  COMMIT BLOCKED - FORENSIC BLOCK INVALID${NC}"
    echo -e "${RED}========================================${NC}"
    echo ""
    for v in "${VIOLATIONS[@]}"; do
        echo -e "  ${YELLOW}*${NC} $v"
    done
    echo ""
    echo -e "${YELLOW}Why this matters:${NC} the forensic block is the bridge between commits"
    echo "and bug archaeology. An auto-filled or empty block is worse than no block"
    echo "at all - it lies to the next person who runs git log --grep."
    echo ""
    echo -e "${YELLOW}Fix:${NC} edit the commit message and replace the placeholder text with"
    echo "what was actually tested and what was deferred. 'NONE' is honest. <TODO:...> is not."
    echo ""
    echo -e "${YELLOW}Emergency bypass:${NC} git commit --no-verify (don't make it a habit)"
    exit 1
fi

exit 0
